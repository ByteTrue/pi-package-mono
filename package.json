{
  "name": "pi-package-mono",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo of personal pi coding-agent packages.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "small-extensions/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present"
  },
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "fsevents": false
  },
  "overrides": {
    "undici": "8.11.2"
  },
  "devDependencies": {
    "source-map-js": "1.2.2"
  }
}
