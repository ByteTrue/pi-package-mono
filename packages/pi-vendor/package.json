{
  "name": "@bytetrue/pi-vendor",
  "version": "0.3.3",
  "description": "AI-first Pi provider and model management with a bundled skill, script, and cold-start wizard.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "models.json",
    "provider",
    "vendor",
    "llm",
    "agent"
  ],
  "type": "module",
  "license": "MIT",
  "author": "byte",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByteTrue/pi-package-mono.git",
    "directory": "packages/pi-vendor"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/**",
    "!src/**/*.test.ts",
    "skills/**",
    "docs/banner.webp",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.79.10",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
