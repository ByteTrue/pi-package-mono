{
  "name": "@bytetrue/pi-browser",
  "version": "0.1.0",
  "description": "Pi extension: set up the official playwright-cli + skill, and import your daily browser's login state into a managed profile.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "playwright",
    "browser",
    "automation"
  ],
  "type": "module",
  "license": "MIT",
  "author": "byte",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByteTrue/pi-package-mono.git",
    "directory": "packages/pi-browser"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/**",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
